# 足球对冲 P0.8 · 环境变量示例（复制为 .env 或按需设置）
# 密钥统一放【包外】secrets/ 目录（工程根同级 C:\1\football_hedge_p0\secrets\），
# 不随交付包分发。以下环境变量为可选覆盖，优先级高于 secrets 文件。

# ---- The Odds API（对手源）----
# 注册：https://the-odds-api.com 免费 500 次/月；免费层取各家最高价，本系统按公司入库
# 文件方式：C:\1\football_hedge_p0\secrets\oddsapi_key.txt（32 位，无 BOM）
ODDS_API_KEY=

# ---- AdsPower（DAFABET CDP 驻留）----
# 文件方式：C:\1\football_hedge_p0\secrets\adspower_token.txt
ADS_POWER_TOKEN=

# ---- 飞书机器人告警（可选）----
# 建一个群机器人拿 Webhook URL；为空则不推送（scheduler 自动跳过）
# 触发：新套利机会 / 源健康状态恶化
FEISHU_WEBHOOK=

# ---- 代理（v2rayN）----
# The Odds API / Dafabet 出境需要；本机默认 10808
HTTP_PROXY=http://127.0.0.1:10808

# ---- 资金参数（引擎默认，可在 Web 前端覆盖）----
HEDGE_BUDGET=1000
STAKE_STEP=1
MIN_STAKE=1
